{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthos",
  "compatibility_date": "2026-09-29",
  // `wrangler deploy` builds the app itself first, so a deploy never ships a stale or missing build
  // (Cloudflare's "npx wrangler deploy" alone is enough — no separate build command needed).
  "build": { "command": "npx vite build" },
  // The Worker handles /api/* (food search); everything else is the app's static files.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/now"]
  },
  // Notifications: one Durable Object per account (worker/push.ts) — SQLite-backed, so it's on the
  // free plan, and created by `wrangler deploy` itself; nothing to set up in the dashboard.
  // The Fitbit band: one per account too (worker/band.ts). Needs the GOOGLE_CLIENT_ID and
  // GOOGLE_CLIENT_SECRET secrets (set by the owner in Cloudflare); without them /api/band/* says 503.
  "durable_objects": { "bindings": [{ "name": "PUSH", "class_name": "PushHub" }, { "name": "BAND", "class_name": "BandHub" }] },
  "migrations": [{ "tag": "v1-push", "new_sqlite_classes": ["PushHub"] }, { "tag": "v2-band", "new_sqlite_classes": ["BandHub"] }]
}
